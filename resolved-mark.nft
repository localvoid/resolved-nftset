table inet resolved_route {
    # IPv4 addresses resolved for matched hostnames.
    # Elements expire after 1 hour; dns-nft-monitor re-adds them on each
    # new DNS response, effectively refreshing the TTL.
    set default_v4 {
        type ipv4_addr
        flags timeout
        timeout 1h
        gc-interval 5m
    }

    # IPv6 addresses resolved for matched hostnames.
    set default_v6 {
        type ipv6_addr
        flags timeout
        timeout 1h
        gc-interval 5m
    }

    # Mark IP addresses
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;

        ip  daddr @default_v4 meta mark set 0xFF
        ip6 daddr @default_v6 meta mark set 0xFF
    }
}
